# ====================================================================
# BIẾN MÔI TRƯỜNG DỰ ÁN CỌC TRE HUYỀN DƯƠNG (PRODUCTION & STAGING)
# Sao chép tệp này thành .env trên máy chủ trước khi chạy Docker Compose:
#   cp .env.example .env
# ====================================================================

# 1. Cơ sở dữ liệu PostgreSQL
# Đặt mật khẩu mạnh và an toàn cho người dùng postgres
DATABASE_PASSWORD=your_secure_postgres_password_here_min_16_chars

# 2. Khóa xác thực nội bộ giữa Frontend (Next.js) và Backend (Spring Boot)
# BẮT BUỘC: Không có giá trị mặc định, tối thiểu 16 ký tự.
# Lệnh sinh khóa ngẫu nhiên trên máy chủ: openssl rand -hex 32
INTERNAL_SECRET=generate_a_random_secret_with_openssl_rand_hex_32

# 3. Tài khoản Quản trị viên khởi tạo lần đầu
# Sau lần khởi động đầu tiên, thông tin này được lưu vào database và có thể đổi mật khẩu qua CMS Admin
APP_ADMIN_INITIAL_EMAIL=huyenduong70@gmail.com
APP_ADMIN_INITIAL_PASSWORD=your_super_admin_password_min_12_chars

# 4. Cấu hình gửi Email Báo giá tự động qua Resend
RESEND_API_KEY=re_your_resend_api_key_here
NOTIFICATION_EMAIL=huyenduong70@gmail.com
RESEND_FROM_EMAIL="Cọc Tre Huyền Dương <onboarding@resend.dev>"

# 5. Cấu hình Reverse Proxy & Chống giả mạo IP
# Đặt TRUST_PROXY=true khi triển khai qua Nginx Docker hoặc Cloudflare
TRUST_PROXY=true
# Đặt BEHIND_CLOUDFLARE=true nếu domain được bật Cloudflare Proxy (đám mây cam)
BEHIND_CLOUDFLARE=false
# PROXY_SECRET=optional_shared_secret_between_proxy_and_app

# 6. Cấu hình lưu trữ ảnh bền vững CMS (Mặc định dùng Local Docker Volume: uploads_data)
# Nếu sử dụng Cloudflare R2:
# STORAGE_DRIVER=r2
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET_NAME=coctre-uploads
# R2_PUBLIC_URL=https://images.coctrehuyenduong.com

# Nếu sử dụng AWS S3:
# STORAGE_DRIVER=s3
# AWS_REGION=ap-southeast-1
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# AWS_BUCKET_NAME=coctre-uploads
