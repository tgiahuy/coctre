{
  "name": "coctre-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Hệ thống website & quản trị Cọc Tre Hòa Bình",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix frontend run start",
    "lint": "npm --prefix frontend run lint",
    "backend:dev": "cd backend && ./mvnw spring-boot:run",
    "backend:build": "cd backend && ./mvnw clean package -DskipTests",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "tunnel": "cloudflared tunnel --url http://localhost:3000"
  }
}
