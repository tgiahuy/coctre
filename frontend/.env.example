# ==========================================
# CẤU HÌNH GỬI EMAIL THÔNG BÁO BÁO GIÁ (RESEND API)
# ==========================================

# 1. API Key từ Resend (Đăng ký miễn phí tại https://resend.com - nhận 3.000 email/tháng không cần thẻ tín dụng)
# Ví dụ: re_123456789_abcdefg
RESEND_API_KEY=

# 2. Hòm thư nhận thông báo đơn báo giá mới (Mặc định: huyenduong70@gmail.com)
NOTIFICATION_EMAIL=huyenduong70@gmail.com

# 3. Địa chỉ người gửi (Mặc định dùng onboarding@resend.dev khi chưa xác thực tên miền riêng)
# Sau khi xác thực domain coctrehuyenduong.vn trên Resend, bạn có thể đổi thành:
# RESEND_FROM_EMAIL="Cọc Tre Huyền Dương <baogia@coctrehuyenduong.vn>"
RESEND_FROM_EMAIL="Cọc Tre Huyền Dương <onboarding@resend.dev>"

# ==========================================
# CẤU HÌNH BACKEND
# ==========================================
BACKEND_API_URL=http://localhost:8080
