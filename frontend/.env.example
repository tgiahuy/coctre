# ==========================================
# CẤU HÌNH GỬI EMAIL THÔNG BÁO BÁO GIÁ (RESEND API)
# ==========================================

# 1. API Key từ Resend (Đăng ký miễn phí tại https://resend.com - nhận 3.000 email/tháng không cần thẻ tín dụng)
# Ví dụ: re_123456789_abcdefg
RESEND_API_KEY=

# 2. Hòm thư nhận thông báo đơn báo giá mới (Mặc định: huyenduong70@gmail.com)
NOTIFICATION_EMAIL=huyenduong70@gmail.com

# 3. Địa chỉ người gửi
# Thử nghiệm: "Cọc Tre Huyền Dương <onboarding@resend.dev>"
# Production (sau khi xác minh domain trên Resend): "Cọc Tre Huyền Dương <baogia@coctrehuyenduong.com>"
RESEND_FROM_EMAIL="Cọc Tre Huyền Dương <onboarding@resend.dev>"

# ==========================================
# CẤU HÌNH BACKEND
# ==========================================
BACKEND_API_URL=http://localhost:8080

# ==========================================
# CẤU HÌNH LƯU TRỮ ẢNH (CHỌN 1 TRONG 3 PHƯƠNG ÁN)
# ==========================================
# Phương án 1: Thư mục lưu trữ cố định (Docker Volume hoặc thư mục cục bộ)
UPLOAD_DIR=/app/public/uploads

# Phương án 2: Cloudflare R2 (Khuyên dùng khi deploy Vercel / Cloud Container)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=coctre-uploads
# R2_PUBLIC_URL=https://pub-xxx.r2.dev

# Phương án 3: Amazon S3 / MinIO
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=coctre-uploads
# AWS_S3_REGION=ap-southeast-1
# AWS_S3_PUBLIC_URL=https://coctre-uploads.s3.ap-southeast-1.amazonaws.com
