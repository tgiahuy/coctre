# ==========================================
# CẤU HÌNH GỬI EMAIL THÔNG BÁO BÁO GIÁ (RESEND API)
# ==========================================

# 1. API Key từ Resend (Đăng ký tại https://resend.com)
RESEND_API_KEY=

# 2. Hòm thư nhận thông báo đơn báo giá mới (Mặc định: huyenduong70@gmail.com)
NOTIFICATION_EMAIL=huyenduong70@gmail.com

# 3. Địa chỉ người gửi
RESEND_FROM_EMAIL="Cọc Tre Huyền Dương <onboarding@resend.dev>"

# ==========================================
# CẤU HÌNH KẾT NỐI BACKEND & BẢO MẬT NỘI BỘ
# ==========================================
BACKEND_API_URL=http://localhost:8080
BACKEND_INTERNAL_URL=http://backend:8080/api/v1
INTERNAL_BACKEND_URL=http://backend:8080/api/v1

# Khóa xác thực nội bộ giao tiếp với Backend Spring Boot
# Cần trùng khớp với APP_INTERNAL_SECRET trong backend (tối thiểu 16 ký tự)
INTERNAL_SECRET=generate_a_random_secret_min_16_chars

# Proxy & IP headers
TRUST_PROXY=true
BEHIND_CLOUDFLARE=false

# ==========================================
# CẤU HÌNH LƯU TRỮ ẢNH (CHỌN 1 TRONG 3 PHƯƠNG ÁN)
# ==========================================
# Phương án 1: Thư mục lưu trữ cục bộ / Docker Volume (Mặc định)
UPLOAD_DIR=/app/public/uploads

# Phương án 2: Cloudflare R2 (Khuyên dùng khi triển khai Cloud)
# STORAGE_DRIVER=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=coctre-uploads
# R2_PUBLIC_URL=https://images.coctrehuyenduong.com

# Phương án 3: Amazon S3
# STORAGE_DRIVER=s3
# AWS_REGION=ap-southeast-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_BUCKET_NAME=coctre-uploads
