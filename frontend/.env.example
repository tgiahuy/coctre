# ==========================================
# GOOGLE FORM NHẬN YÊU CẦU BÁO GIÁ (STATIC SITE)
# ==========================================

# URL dạng https://docs.google.com/forms/d/e/.../viewform
NEXT_PUBLIC_GOOGLE_FORM_URL=https://docs.google.com/forms/d/e/1FAIpQLSefT_o4W2ABiz4xMdc7WJjNNtU8k0iLwR2GvDEHKCF8mua7EQ/viewform

# Tên tham số lấy từ liên kết "Điền trước" của Google Form, ví dụ entry.123456789
NEXT_PUBLIC_GOOGLE_FORM_FIELD_NAME=entry.1532961624
NEXT_PUBLIC_GOOGLE_FORM_FIELD_PHONE=entry.1998010128
NEXT_PUBLIC_GOOGLE_FORM_FIELD_EMAIL=entry.2085342272
NEXT_PUBLIC_GOOGLE_FORM_FIELD_COMPANY=entry.233242103
NEXT_PUBLIC_GOOGLE_FORM_FIELD_ADDRESS=entry.785649356
NEXT_PUBLIC_GOOGLE_FORM_FIELD_PRODUCT=entry.1077567526
NEXT_PUBLIC_GOOGLE_FORM_FIELD_QUANTITY=entry.1103630816
NEXT_PUBLIC_GOOGLE_FORM_FIELD_NOTES=entry.258662212

# Các biến bên dưới chỉ dành cho phiên bản full-stack đã lưu ở nhánh archive/fullstack.
# Bản static production không cần cấu hình chúng.

# ==========================================
# CẤU HÌNH GỬI EMAIL THÔNG BÁO BÁO GIÁ (RESEND API)
# ==========================================

# 1. API Key từ Resend (Đăng ký tại https://resend.com)
RESEND_API_KEY=

# 2. Hòm thư nhận thông báo đơn báo giá mới (Mặc định: huyenduong70@gmail.com)
NOTIFICATION_EMAIL=huyenduong70@gmail.com

# 3. Địa chỉ người gửi
RESEND_FROM_EMAIL="Cọc Tre Huyền Dương <onboarding@resend.dev>"

# ==========================================
# CẤU HÌNH KẾT NỐI BACKEND & BẢO MẬT NỘI BỘ
# ==========================================
BACKEND_API_URL=http://localhost:8080
BACKEND_INTERNAL_URL=http://backend:8080/api/v1
INTERNAL_BACKEND_URL=http://backend:8080/api/v1

# Khóa xác thực nội bộ giao tiếp với Backend Spring Boot
# Cần trùng khớp với APP_INTERNAL_SECRET trong backend (tối thiểu 16 ký tự)
INTERNAL_SECRET=generate_a_random_secret_min_16_chars

# Proxy & IP headers
TRUST_PROXY=true
BEHIND_CLOUDFLARE=false

# ==========================================
# CẤU HÌNH LƯU TRỮ ẢNH (CHỌN 1 TRONG 3 PHƯƠNG ÁN)
# ==========================================
# Phương án 1: Thư mục lưu trữ cục bộ / Docker Volume (Mặc định)
UPLOAD_DIR=/app/public/uploads

# Phương án 2: Cloudflare R2 (Khuyên dùng khi triển khai Cloud)
# STORAGE_DRIVER=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=coctre-uploads
# R2_PUBLIC_URL=https://images.coctrehuyenduong.com

# Phương án 3: Amazon S3
# STORAGE_DRIVER=s3
# AWS_REGION=ap-southeast-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_BUCKET_NAME=coctre-uploads
